# Copy this file to .env.local and fill in real values.
# See docs/OWNER_SETUP_CHECKLIST.md for exactly where each of these comes from.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Invitation Coach + message variation) ------------------------
ANTHROPIC_API_KEY=

# --- Microsoft Graph (per-tenant mailbox connection) -------------------------
# One Azure AD app registration serves all tenants; each Host authorizes it
# individually via "Connect your Microsoft account" in Settings.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# --- Security -----------------------------------------------------------------
# 32-byte key (base64) used to encrypt mailbox refresh tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
