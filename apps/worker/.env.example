# The send worker runs as its own always-on process (Railway recommended —
# see docs/OWNER_SETUP_CHECKLIST.md). It needs its own copy of these values;
# it does NOT share the Next.js app's runtime, only the same database.

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Must be IDENTICAL to the web app's TOKEN_ENCRYPTION_KEY — the worker
# decrypts refresh tokens the web app encrypted at connect time.
TOKEN_ENCRYPTION_KEY=

WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=5
